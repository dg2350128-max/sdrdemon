    <!-- Row 5: Mute / volume meter -->
    <item>
     <layout class="QHBoxLayout">
      <item>
       <widget class="QToolButton" name="channelMute">
        <property name="toolTip"><string>Mute channel</string></property>
        <property name="text"><string>Mute</string></property>
