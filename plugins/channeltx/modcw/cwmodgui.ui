  <!-- ============================================================
       Container 1: RF / Channel settings
       ============================================================ -->
  <widget class="QWidget" name="settingsContainer" native="true">
   <property name="geometry">
    <rect>
     <x>2</x>
     <y>2</y>
     <width>385</width>
     <height>220</height>
    </rect>
   </property>
   <property name="windowTitle">
    <string>Settings</string>
