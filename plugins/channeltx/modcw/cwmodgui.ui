          <property name="minimumSize"><size><width>32</width><height>32</height></size></property>
          <property name="font">
           <font><family>Liberation Mono</family><pointsize>11</pointsize></font>
          </property>
          <property name="toolTip"><string>Frequency shift from device centre</string></property>
         </widget>
